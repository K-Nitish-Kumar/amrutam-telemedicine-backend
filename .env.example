# Copy to .env and edit the values for your local PostgreSQL installation.
# Never commit .env or reuse development credentials in production.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://amrutam_local:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/amrutam_local
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATA_ENCRYPTION_KEYS=REPLACE_WITH_A_FERNET_KEY
METRICS_TOKEN=REPLACE_WITH_A_RANDOM_METRICS_TOKEN
CORS_ORIGINS=http://localhost:3000
PAYMENTS_MODE=demo
LOG_LEVEL=INFO
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
ACCESS_TOKEN_MINUTES=30
ADMIN_EMAIL=admin@amrutam.local
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
